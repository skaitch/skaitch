{
  "name": "skaitch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @skaitch/web dev",
    "build": "pnpm --filter @skaitch/web build",
    "test": "pnpm -r test",
    "mcp": "pnpm --filter @skaitch/web mcp",
    "preview": "pnpm --filter @skaitch/web preview",
    "deploy": "pnpm --filter @skaitch/web deploy",
    "deploy:preview": "pnpm --filter @skaitch/web deploy:preview",
    "desktop": "pnpm --filter @skaitch/desktop build && pnpm --filter @skaitch/desktop start"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@8.13.1",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.14.7",
      "fast-xml-parser": "^5.12.0"
    },
    "patchedDependencies": {
      "jwks-rsa@4.1.0": "patches/jwks-rsa@4.1.0.patch"
    }
  },
  "devDependencies": {
    "@types/three": "^0.187.0"
  },
  "license": "AGPL-3.0-only"
}
