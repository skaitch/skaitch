{
  "name": "@skaitch/desktop",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "skAItch desktop app (Electron)",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "pnpm --filter @skaitch/core build && pnpm run build:electron && pnpm run build:renderer",
    "start": "node scripts/ensure-electron.mjs && electron .",
    "smoke": "node scripts/ensure-electron.mjs && node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "package": "pnpm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@skaitch/core": "workspace:*",
    "@skaitch/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "electron": "44.10.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-only"
}
