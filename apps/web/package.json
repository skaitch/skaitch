{
  "name": "@skaitch/web",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx --conditions=@skaitch/source server/mcp-server.ts",
    "build": "pnpm --filter @skaitch/core build && node scripts/build-info.mjs && tsc && vite build",
    "preview": "vite preview",
    "vercel:setup": "pnpm dlx vercel login && pnpm dlx vercel link",
    "deploy": "pnpm run build && pnpm dlx vercel --prod --yes",
    "deploy:preview": "pnpm run build && pnpm dlx vercel --yes"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@thatopen/components": "^3.6.0",
    "@thatopen/fragments": "^3.6.0",
    "@types/three": "^0.187.0",
    "camera-controls": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "three-pivot-controls": "0.1.0",
    "web-ifc": "0.0.77",
    "@skaitch/core": "workspace:*",
    "@skaitch/ui": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.1",
    "fflate": "0.8.3"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "license": "AGPL-3.0-only"
}
