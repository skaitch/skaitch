{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile --filter @skaitch/web...",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://skaich-488b5.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://skaich-488b5.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server(/.*)?",
      "destination": "/api/oauth/metadata?kind=as"
    },
    {
      "source": "/.well-known/openid-configuration(/.*)?",
      "destination": "/api/oauth/metadata?kind=as"
    },
    {
      "source": "/.well-known/oauth-protected-resource(/.*)?",
      "destination": "/api/oauth/metadata?kind=pr"
    },
    {
      "source": "/download/:platform",
      "destination": "/api/download?platform=:platform"
    },
    {
      "source": "/((?!api|assets|wasm|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 180,
      "memory": 1024
    },
    "api/ai.ts": {
      "maxDuration": 180,
      "memory": 1024
    },
    "api/bim.ts": {
      "maxDuration": 180,
      "memory": 2048,
      "includeFiles": "../../node_modules/.pnpm/web-ifc@0.0.77/node_modules/web-ifc/web-ifc-node.wasm"
    },
    "api/survey.ts": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/usage?purge=1",
      "schedule": "17 3 * * *"
    }
  ]
}
