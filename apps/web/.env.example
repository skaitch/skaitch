# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables.

# ── Firebase ───────────────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── MCP Bridge (local only) ───────────────────────────────────────────────────
# WebSocket URL of the local MCP server (npm run mcp).
# Local bridge only. The remote MCP endpoint is served by api/mcp.ts on Vercel.
VITE_MCP_WS_URL=ws://localhost:3001

# ── Remote MCP OAuth (server only; never prefix with VITE_) ──────────────────
# Generate with: openssl rand -hex 32
OAUTH_SECRET=
# During a rotation, put the old value here so tokens sealed with it keep working until they expire.
OAUTH_SECRET_PREVIOUS=
# Canonical HTTPS deployment URL (must match the URL entered in ChatGPT / Claude).
PUBLIC_BASE_URL=https://app.skaitch.online
# Optional manually registered OAuth client; normally leave empty and use DCR.
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URIS=

# Server Firestore access for MCP key validation and browser mailboxes.
# JSON service account from the SAME Firebase project; grant roles/datastore.user.
# Server routes in Vercel and Vite development only. Never prefix with VITE_ or commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase uids allowed to read usage statistics (/api/usage), comma separated.
SKAITCH_ADMIN_UIDS=
# Secret sent by the Vercel cron that purges usage totals older than 90 days.
CRON_SECRET=

# ── AI credential vault (server only; never prefix with VITE_) ────────────────
# Separate from OAUTH_SECRET. Generate with: openssl rand -hex 32
# Keep this value backed up: changing it makes stored AI keys unreadable.
AI_VAULT_SECRET=

# Alternative for a local Google Cloud credential file already authorized for this project.
# Server only. Does not grant IAM permissions; never prefix with VITE_.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Desktop downloads (server only; never prefix with VITE_) ─────────────────
# api/download.ts serves the installers attached to the latest GitHub release.
# Fine-grained token limited to this repository, permission "Contents: read-only".
GITHUB_TOKEN=
# owner/name of the repository holding the releases (default skaitch/skaitch).
GITHUB_REPO=skaitch/skaitch
